<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Patware.PingTrace.Adapter.ActiveDirectory</PackageId>
    <Description>Active Directory domain diagnostics through application-configured directory readers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingTrace.Core\PingTrace.Core.csproj" />
    <ProjectReference Include="..\PingTrace.Runtime\PingTrace.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.13" />
  </ItemGroup>

</Project>
