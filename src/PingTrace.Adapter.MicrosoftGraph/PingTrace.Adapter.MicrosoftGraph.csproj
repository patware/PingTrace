<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Patware.PingTrace.Adapter.MicrosoftGraph</PackageId>
    <Description>Microsoft Graph organization diagnostics through a registered GraphServiceClient.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingTrace.Core\PingTrace.Core.csproj" />
    <ProjectReference Include="..\PingTrace.Runtime\PingTrace.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph" Version="6.8.0" />
  </ItemGroup>

</Project>
